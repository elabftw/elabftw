msgstr "Nombre d'horodatages autorisés par mois (0 signifie pas de limite) :"

#: src/templates/ts-config.html:70
msgid "Number of timestamps over the last 30 days: %d"
msgstr "Nombre d'horodatages ces 30 derniers jours : %d"

#: src/templates/ts-config.html:75
