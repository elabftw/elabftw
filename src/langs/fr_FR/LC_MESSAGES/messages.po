msgid ""
"%s, %s and %s require to be surrounded by whitespace while %s, %s and %s "
"don't."
msgstr ""
"%s, %s et %s doivent être entourés d’espaces, contrairement à %s, %s et %s."

#: src/templates/search-help-modal.html:98
